    <string name="settings_startup_buffer">Startup buffer</string>
    <string name="settings_startup_buffer_summary">%1$s. How much video the engine collects before a stream starts. More buffer starts slower but stutters less.</string>
    <string name="settings_startup_buffer_smooth">Smooth (30 s, default)</string>
    <string name="settings_startup_buffer_balanced">Balanced (15 s)</string>
    <string name="settings_startup_buffer_fast">Fast (5 s)</string>
    <string name="settings_startup_buffer_off">Off</string>
    <string name="settings_hls_start">HLS start</string>
    <string name="settings_hls_start_summary">%1$s. How many segments are ready before an HLS player gets the playlist. Only affects Open HLS.</string>
    <string name="settings_hls_start_default">Default (6 segments of 5 s)</string>
    <string name="settings_hls_start_fast">Fast (2 segments of 4 s)</string>
    <string name="settings_catalog_fallback">Catalog fallback</string>
    <string name="settings_catalog_fallback_summary">If the catalog can\'t resolve a content id, ask peers for its details. Needed to play an Outpace broadcast started on another device.</string>
    <string name="settings_low_memory">Low-memory mode</string>
    <string name="settings_low_memory_summary">Keep seeding data in storage instead of memory and use smaller buffers. For devices with little RAM. A 32 MiB startup cap shortens the startup buffer on high-bitrate streams.</string>
    <string name="settings_upload_limit">Inbound upload limit</string>
    <string name="settings_upload_limit_summary">%1$s. How many peers that connect to this device may download from it at once. Uploads to peers this device connected to are not limited; turn off Seeding to stop all uploads.</string>
    <string name="settings_upload_limit_normal">Normal (default)</string>
    <string name="settings_upload_limit_low">Low (up to 3 inbound peers per stream)</string>
    <string name="settings_upload_limit_minimal">Minimal (1 inbound peer per stream)</string>
    <string name="settings_peer_port">Peer port</string>
    <string name="settings_peer_port_summary">The TCP port other peers connect to and the router maps. Default 8621.</string>
    <string name="settings_port_conflict">The HTTP and peer ports must differ, and neither can be 1935.</string>
