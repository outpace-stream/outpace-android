    <string name="settings_autosave">Changes save as you make them and apply the next time the engine starts.</string>
    <string name="settings_section_search">Search</string>
    <string name="settings_search">Stream search</string>
    <string name="settings_search_summary">Look up streams by name through AceStream\'s public index. Queries and this device\'s IP address go to that service over plain HTTP. Needs engine v1.0.0 or newer.</string>
