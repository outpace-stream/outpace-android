<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/page_padding" android:paddingEnd="@dimen/page_padding"
        android:paddingTop="16dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/intro" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:text="@string/licenses_intro" android:visibility="gone" />
        <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:id="@+id/detail" style="@style/Text.Mono" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
