<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true" android:background="@color/bg">
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />
    <LinearLayout android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/surface" android:padding="6dp" />
</LinearLayout>
