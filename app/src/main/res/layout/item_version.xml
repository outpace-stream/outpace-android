<?xml version="1.0" encoding="utf-8"?>
<!-- One engine release: version and badges on the left, its actions on the right. Only the buttons
     take focus, so D-pad moves straight between actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:baselineAligned="false" android:background="@drawable/bg_card"
    android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/title" style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/meta" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp" />
    </LinearLayout>
    <Button android:id="@+id/remove" style="@style/Button.Text" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/version_remove" />
    <Button android:id="@+id/action" style="@style/Button.Primary" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp" />
</LinearLayout>
