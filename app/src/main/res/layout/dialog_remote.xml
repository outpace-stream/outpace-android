<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp">
    <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/remote_name" />
    <EditText android:id="@+id/remote_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/remote_name_hint" android:inputType="textCapSentences" android:maxLength="40"
        android:maxLines="1" android:importantForAutofill="no" android:imeOptions="actionNext" />
    <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/remote_address" />
    <EditText android:id="@+id/remote_address" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/remote_address_hint" android:inputType="textUri|textNoSuggestions" android:maxLines="1"
        android:importantForAutofill="no" android:imeOptions="actionDone" android:fontFamily="monospace" />
    <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/remote_address_help" />
</LinearLayout>
