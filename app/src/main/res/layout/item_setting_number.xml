<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row with a number field, styled like the HTTP port row. The field takes focus, so
     the row itself does not. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:baselineAligned="false" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/title" style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:labelFor="@id/number" />
        <TextView android:id="@+id/summary" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp" />
    </LinearLayout>
    <EditText android:id="@+id/number" android:layout_width="96dp" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:minHeight="44dp" android:paddingStart="8dp"
        android:paddingEnd="8dp" android:gravity="center" android:inputType="number" android:maxLength="5"
        android:imeOptions="actionDone" android:importantForAutofill="no" android:fontFamily="monospace" />
</LinearLayout>
