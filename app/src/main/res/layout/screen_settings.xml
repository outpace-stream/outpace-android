<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/page_padding" android:paddingEnd="@dimen/page_padding"
        android:paddingTop="@dimen/page_top" android:paddingBottom="32dp">

        <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_title" />
        <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/settings_autosave_app" />

        <TextView style="@style/Section" android:text="@string/settings_section_background" />
        <LinearLayout android:id="@+id/group_background" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="4dp"
            android:showDividers="middle" android:divider="@drawable/divider_inset" />

        <TextView style="@style/Section" android:text="@string/settings_section_updates" />
        <LinearLayout android:id="@+id/group_updates" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="4dp"
            android:showDividers="middle" android:divider="@drawable/divider_inset" />

        <TextView style="@style/Section" android:text="@string/settings_section_about" />
        <LinearLayout style="@style/Card" android:padding="16dp">
            <TextView android:id="@+id/about" style="@style/Text.Muted" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
