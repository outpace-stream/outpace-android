<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/page_padding" android:paddingEnd="@dimen/page_padding" android:paddingTop="16dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/running" style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/latest" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp" />
        <TextView android:id="@+id/note" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />

        <!-- A download in progress: its text and bar on the left, Cancel on the same row. It is a
             progress row, not a dialog button bar, so lint's button order rule does not apply. -->
        <LinearLayout android:id="@+id/download" style="@style/Card" android:layout_marginTop="12dp" android:padding="16dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
            android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/download_text" style="@style/Text.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ProgressBar android:id="@+id/download_progress" style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:max="1000" />
            </LinearLayout>
            <Button android:id="@+id/download_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/cancel" tools:ignore="ButtonOrder" />
        </LinearLayout>

        <!-- The list's options on one aligned row: the filter on the left, Refresh on the right. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false">
            <CheckBox android:id="@+id/show_pre" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:text="@string/versions_show_pre" />
            <Button android:id="@+id/refresh" style="@style/Button.Text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/versions_refresh" />
        </LinearLayout>
        <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
