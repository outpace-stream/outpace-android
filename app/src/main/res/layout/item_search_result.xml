<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp"
    android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/title" style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/meta" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <Button android:id="@+id/play" style="@style/Button.Primary" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/action_play" />
</LinearLayout>
