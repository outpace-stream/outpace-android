<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls when large text or a short window would clip the actions, so D-pad focus can reach them. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:background="@color/surface">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/name" style="@style/Text.Headline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/ref" style="@style/Text.Mono" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp" />
        <TextView android:id="@+id/status" style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/url" style="@style/Text.Mono" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textIsSelectable="true" />
        <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
            <Button android:id="@+id/open_vlc" style="@style/Button.Primary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/play_open_vlc"
                android:visibility="gone" />
            <Button android:id="@+id/open" style="@style/Button.Primary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/play_open_player" />
            <Button android:id="@+id/open_hls" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/play_open_hls" />
            <Button android:id="@+id/cast" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/play_on_tv" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/copy" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/play_copy" />
                <Button android:id="@+id/share" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/play_share" />
            </LinearLayout>
            <LinearLayout android:id="@+id/vlc_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
                <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/play_vlc_hint" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/get_vlc" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/play_get_vlc" />
                    <Button android:id="@+id/vlc_hint_dismiss" style="@style/Button.Text" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="@string/play_vlc_hint_dismiss" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
