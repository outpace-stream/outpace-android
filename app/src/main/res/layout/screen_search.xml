<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_scroll" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/page_padding" android:paddingEnd="@dimen/page_padding"
        android:paddingTop="@dimen/page_top" android:paddingBottom="32dp">

        <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/search_title" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:id="@+id/query" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="@string/search_hint" android:imeOptions="actionSearch"
                android:inputType="text" android:importantForAutofill="no" android:maxLines="1" android:maxLength="256" />
            <Button android:id="@+id/search" style="@style/Button.Primary" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/action_search" />
        </LinearLayout>

        <LinearLayout android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_notice" android:orientation="vertical"
            android:padding="16dp" android:visibility="gone">
            <TextView android:id="@+id/notice_title" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/notice_text" style="@style/Text.Muted" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <Button android:id="@+id/notice_action" style="@style/Button.Primary" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        </LinearLayout>

        <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/status" style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" />

        <TextView android:id="@+id/queries_title" style="@style/Section" android:text="@string/search_recent_queries" />
        <HorizontalScrollView android:id="@+id/queries_scroll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/queries" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical" />
        <Button android:id="@+id/more" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/search_more" android:visibility="gone" />

        <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/search_privacy" />
    </LinearLayout>
</ScrollView>
